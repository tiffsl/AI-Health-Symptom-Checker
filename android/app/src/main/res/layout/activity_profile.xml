<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Personalise your care options"
            android:textColor="#153B5B"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:text="Your details are optional and stored only on this device."
            android:textColor="#667085"
            android:textSize="14sp" />

        <TextView style="@style/SectionLabel" android:text="Basic information" />
        <EditText android:id="@+id/etProfileName" style="@style/FormField" android:hint="Name" android:inputType="textPersonName" />
        <EditText android:id="@+id/etProfileAge" style="@style/FormField" android:hint="Age" android:inputType="number" />
        <Spinner android:id="@+id/spProfileSex" style="@style/FormSpinner" />
        <Spinner android:id="@+id/spBloodType" style="@style/FormSpinner" />

        <TextView style="@style/SectionLabel" android:layout_marginTop="14dp" android:text="Health notes" />
        <EditText android:id="@+id/etConditions" style="@style/FormField" android:hint="Existing conditions (optional)" android:inputType="textCapSentences|textMultiLine" android:minLines="2" />
        <EditText android:id="@+id/etAllergies" style="@style/FormField" android:hint="Allergies (optional)" android:inputType="textCapSentences|textMultiLine" android:minLines="2" />

        <TextView style="@style/SectionLabel" android:layout_marginTop="14dp" android:text="Emergency contact" />
        <EditText android:id="@+id/etEmergencyName" style="@style/FormField" android:hint="Contact name" android:inputType="textPersonName" />
        <EditText android:id="@+id/etEmergencyPhone" style="@style/FormField" android:hint="Contact phone" android:inputType="phone" />

        <TextView style="@style/SectionLabel" android:layout_marginTop="14dp" android:text="Preferred hospital" />
        <EditText android:id="@+id/etPreferredHospital" style="@style/FormField" android:hint="Hospital name" android:inputType="textCapWords" />
        <EditText android:id="@+id/etPreferredHospitalPhone" style="@style/FormField" android:hint="Hospital phone number" android:inputType="phone" />

        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#1769AA"
            android:text="Save profile"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
