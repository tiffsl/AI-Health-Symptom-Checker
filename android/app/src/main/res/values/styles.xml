<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">#153B5B</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="FormField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:background">@drawable/input_bg</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">#1F2937</item>
        <item name="android:textColorHint">#98A2B3</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="FormSpinner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:background">@drawable/input_bg</item>
        <item name="android:paddingHorizontal">12dp</item>
    </style>
</resources>
